<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.EmployeeMapper">
    <update id="update" parameterType="com.sky.entity.Employee">
        update sky_take_out.employee
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <!-- 注意：如果是数字类型，最好不要加引号，虽然 MyBatis 会转，但加上更符合规范 -->
            <if test="sex != null">
                sex = #{sex},
            </if>
            <if test="idNumber != null and idNumber != ''">
                id_number = #{idNumber},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <!-- 注意这里：如果你前端没传 updateTime 和 updateUser，这里会报错，建议加 if 判断 -->
            update_time = #{updateTime},
            update_user = #{updateUser}
        </set>
        where id = #{id}
    </update>

    <select id="pageQuery" resultType="com.sky.entity.Employee">
        select * from sky_take_out.employee
        <where>
            <if test="name != null and name != ''">
                and name like CONCAT('%', #{name}, '%')
            </if>
        </where>
        order by create_time desc
    </select>
    <select id="getById" resultType="com.sky.entity.Employee">
        select * from sky_take_out.employee where id = #{id}
    </select>
</mapper>
